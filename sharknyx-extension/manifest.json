{
  "manifest_version": 3,
  "name": "SharkNyx Free × Roblox Studio Agent",
  "version": "1.2.7",
  "description": "Turn supported AI chats into a Roblox Studio agent, with a local SharkNyx Portal relay.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://www.kimi.ai/*",
    "https://kimi.ai/*",
    "https://chat.z.ai/*",
    "https://chat.qwen.ai/*",
    "https://arena.ai/*",
    "https://ptero.pro/*",
    "https://claude.ai/*",
    "https://duck.ai/*",
    "https://console.groq.com/*",
    "https://www.perplexity.ai/*",
    "https://huggingface.co/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "ws://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SharkNyx Free",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "portal-relay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "providers/chatgpt-cm.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/chatgpt.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/gemini.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.kimi.ai/*",
        "https://kimi.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/kimi.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.z.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/glm.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://arena.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/arena.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.meta.ai/*",
        "https://meta.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/meta.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ptero.pro/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/ptero.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/claude.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://duck.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/simple-chat.js",
        "providers/duck.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://console.groq.com/chat*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/simple-chat.js",
        "providers/groq.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/simple-chat.js",
        "providers/perplexity.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://huggingface.co/chat*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/simple-chat.js",
        "providers/huggingchat.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "providers/qwen-net.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/qwen.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
